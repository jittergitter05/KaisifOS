# ==============================================================================
# KaisifOS Environment Configuration (12 Core Variables + 2 Optional Overrides)
# Copy to .env for local development or configure in Cloud Run / Vercel / GitHub Secrets.
# Zero-key mode works out of the box via Hybrid Store (/tmp fallback on read-only hosts) + Rubric v3.2.
# ==============================================================================

# --- 1. Free Multi-LLM Failover Chain (Tier 1 -> Tier 2 -> Tier 3 -> Rubric v3.2) ---
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
# Optional model alias override for Gemini (defaults to gemini-4-hydrogen)
GEMINI_MODEL=""

# --- 2. Optional External Job & Direct-ATS Bridges (Built-in Greenhouse/Lever/Ashby work with 0 keys) ---
FREEHIRE_API_URL=""
RAPIDAPI_KEY=""

# --- 3. Google Sheets v4 Persistence & Autonomous Gmail Reply Tracker ---
# Recommended on serverless/read-only container hosts so profile.json & jobs persist permanently:
GOOGLE_SHEET_ID=""
GOOGLE_SERVICE_KEY_BASE64=""
# Google Workspace inbox for Domain-Wide Delegation reply tracking:
GMAIL_USER_EMAIL=""
# Optional writable persistent disk mount path (auto-falls back to /tmp/kaisifos-data if read-only):
KAISIFOS_DATA_DIR=""

# --- 4. Notifications & Canonical Origin ---
DISCORD_WEBHOOK_URL=""
APP_URL=""

# --- 5. Operator Console Authentication (Unset = Open Local Operator Mode) ---
ADMIN_USER=""
ADMIN_PASS=""
