# ==============================================================================
# KaisifOS Environment Configuration (12 Supported Variables)
# Copy to .env for local development or configure in Vercel / GitHub Secrets.
# Zero-key mode works out of the box using Hybrid Local Store + Rubric v3.2.
# ==============================================================================

# --- 1. Free Multi-LLM Failover Chain (Tier 1 -> Tier 2 -> Tier 3 -> Rubric v3.2) ---
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""

# --- 2. Optional External Job & Direct-ATS Bridges (Built-in Greenhouse/Lever/Ashby work with 0 keys) ---
FREEHIRE_API_URL=""
RAPIDAPI_KEY=""

# --- 3. Google Sheets v4 Persistence & Autonomous Gmail Reply Tracker ---
GOOGLE_SHEET_ID=""
GOOGLE_SERVICE_KEY_BASE64=""
GMAIL_USER_EMAIL=""

# --- 4. Notifications & Canonical Origin ---
DISCORD_WEBHOOK_URL=""
APP_URL=""

# --- 5. Operator Console Authentication (Unset = Open Local Operator Mode) ---
ADMIN_USER=""
ADMIN_PASS=""
