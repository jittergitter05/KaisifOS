# ==============================================================================
# KaisifOS v4.0 Environment Configuration (Neon Postgres + Multi-LLM + ATS)
# Copy to .env for local development or configure in Cloud Run / Vercel / GitHub Secrets.
# Zero-key mode works out of the box via Hybrid Store (/tmp fallback on read-only hosts) + Rubric v3.2.
# ==============================================================================

# --- 1. Primary Relational Persistence (Neon Serverless Postgres) ---
# Shared across Next.js Web App and GitHub Actions Scout for canonical cross-source deduplication:
DATABASE_URL=""
DATABASE_URL_POOLED=""

# --- 2. Free Multi-LLM Failover Chain (Tier 1 -> Tier 2 -> Tier 3 -> Rubric v3.2) ---
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
# Optional model alias override for Gemini (defaults to gemini-4-hydrogen)
GEMINI_MODEL=""

# --- 3. Optional External Job & Direct-ATS Bridges (Built-in 6 Direct-ATS + Career Pages work with 0 keys) ---
FREEHIRE_API_URL=""
RAPIDAPI_KEY=""

# --- 4. Google Sheets v4 Legacy Mirror & Autonomous Gmail Reply Tracker ---
GOOGLE_SHEET_ID=""
GOOGLE_SERVICE_KEY_BASE64=""
# Google Workspace inbox for Domain-Wide Delegation reply tracking:
GMAIL_USER_EMAIL=""
# Optional writable persistent disk mount path (auto-falls back to /tmp/kaisifos-data if read-only):
KAISIFOS_DATA_DIR=""

# --- 5. Notifications, Alert Ingestion & Canonical Origin ---
DISCORD_WEBHOOK_URL=""
INGEST_WEBHOOK_SECRET=""
APP_URL=""

# --- 6. Operator Console Authentication (Unset = Open Local Operator Mode) ---
ADMIN_USER=""
ADMIN_PASS=""
